modules = ["nodejs-20", "python-3.11", "postgresql-16"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Full Stack App"

[[workflows.workflow]]
name = "Full Stack App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c \"python main.py & cd frontend && npm install && npm run dev\""
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8001
externalPort = 3000

[[ports]]
localPort = 38245
externalPort = 3001

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "libxcrypt", "postgresql"]

[deployment]
deploymentTarget = "autoscale"
run = ["python", "main.py"]
build = [
  "bash",
  "-c",
  "cd /home/runner/workspace && pip install -r requirements.txt && alembic upgrade head && cd frontend && npm install && npm run build",
]
