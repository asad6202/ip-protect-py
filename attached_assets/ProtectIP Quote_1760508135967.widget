{
  "version": "1.0",
  "name": "ProtectIP Quote",
  "template": "{\"type\":\"Card\",\"size\":\"md\",\"background\":\"surface-elevated\",\"confirm\":{\"label\":\"Send quote\",\"action\":{\"type\":\"quote.send\",\"payload\":{\"quoteId\":{{ (quoteId) | tojson }},\"items\":{{ (items) | tojson }},\"total\":{{ (grandTotalFormatted) | tojson }}}}},\"children\":[{\"type\":\"Row\",\"align\":\"center\",\"padding\":{\"x\":4,\"y\":4},\"gap\":3,\"background\":\"#ffffff\",\"children\":[{\"type\":\"Image\",\"src\":{{ (brand.logo) | tojson }},\"alt\":{{ (brand.name) | tojson }},\"width\":160,\"height\":40,\"fit\":\"contain\",\"radius\":\"none\",\"children\":[]},{\"type\":\"Spacer\",\"children\":[]},{\"type\":\"Badge\",\"label\":{{ ((\"Quote #\" ~ quoteId)) | tojson }},\"color\":\"secondary\",\"variant\":\"soft\",\"size\":\"sm\",\"children\":[]}]},{\"type\":\"Row\",\"padding\":{\"x\":4,\"y\":3},\"background\":\"#111111\",\"children\":[{\"type\":\"Col\",\"children\":[{\"type\":\"Title\",\"value\":\"Quote items\",\"size\":\"md\",\"color\":\"#ffffff\",\"children\":[]},{\"type\":\"Caption\",\"value\":{{ ((items.length ~ \" items\")) | tojson }},\"size\":\"sm\",\"color\":\"#e5e5e5\",\"children\":[]}]},{\"type\":\"Spacer\",\"children\":[]},{\"type\":\"Badge\",\"label\":\"DRAFT\",\"size\":\"sm\",\"color\":\"danger\",\"variant\":\"solid\",\"children\":[]}]},{\"type\":\"ListView\",\"children\":[{%- set _c -%}{%-for item in items -%},{\"type\":\"ListViewItem\",\"key\":{{ ((item.id ~ \"-\" ~ idx)) | tojson }},\"gap\":0,\"children\":[{\"type\":\"Row\",\"gap\":3,\"align\":\"stretch\",\"padding\":{\"x\":4,\"y\":3},\"background\":\"#ffffff\",\"border\":{\"bottom\":{\"size\":1,\"color\":\"subtle\"}},\"children\":[{\"type\":\"Col\",\"flex\":1,\"gap\":1,\"children\":[{\"type\":\"Text\",\"value\":{{ (item.description) | tojson }},\"size\":\"sm\",\"weight\":\"semibold\",\"maxLines\":2,\"color\":\"emphasis\",\"children\":[]},{\"type\":\"Caption\",\"value\":{{ ((\"SKU: \" ~ item.sku ~ (none))) | tojson }},\"color\":\"secondary\",\"children\":[]},{\"type\":\"Caption\",\"value\":{{ ((\"Unit: \" ~ item.unitPriceFormatted)) | tojson }},\"color\":\"secondary\",\"children\":[]}]},{\"type\":\"Col\",\"minWidth\":120,\"align\":\"end\",\"gap\":1,\"children\":[{\"type\":\"Caption\",\"value\":{{ ((\"Qty: \" ~ item.quantity)) | tojson }},\"color\":\"secondary\",\"children\":[]},{\"type\":\"Text\",\"value\":{{ (item.subtotalFormatted) | tojson }},\"size\":\"sm\",\"weight\":\"semibold\",\"children\":[]}]}]}]}{%-endfor-%}{%- endset -%}{{- (_c[1:] if _c and _c[0] == ',' else _c) -}}]},{\"type\":\"Divider\",\"children\":[]},{\"type\":\"Row\",\"padding\":{\"x\":4,\"y\":3},\"background\":\"#ffffff\",\"children\":[{\"type\":\"Col\",\"children\":[]},{\"type\":\"Col\",\"minWidth\":260,\"gap\":2,\"children\":[{%- set _c -%},{\"type\":\"Row\",\"children\":[{\"type\":\"Text\",\"value\":\"Subtotal\",\"color\":\"secondary\",\"children\":[]},{\"type\":\"Spacer\",\"children\":[]},{\"type\":\"Text\",\"value\":{{ (subtotalFormatted) | tojson }},\"children\":[]}]}{%-if none -%},{\"type\":\"Row\",\"children\":[{\"type\":\"Text\",\"value\":{{ ((\"Discount\" ~ (none))) | tojson }},\"color\":\"secondary\",\"children\":[]},{\"type\":\"Spacer\",\"children\":[]},{\"type\":\"Text\",\"value\":{{ ((\"- \" ~ discount.formatted)) | tojson }},\"children\":[]}]}{%-else-%}{%-endif-%}{%-if none -%},{\"type\":\"Row\",\"children\":[{\"type\":\"Text\",\"value\":{{ ((\"Tax\" ~ (none))) | tojson }},\"color\":\"secondary\",\"children\":[]},{\"type\":\"Spacer\",\"children\":[]},{\"type\":\"Text\",\"value\":{{ (tax.formatted) | tojson }},\"children\":[]}]}{%-else-%}{%-endif-%},{\"type\":\"Row\",\"padding\":{\"x\":4,\"y\":2},\"background\":\"#111111\",\"radius\":\"lg\",\"children\":[{\"type\":\"Text\",\"value\":\"Total\",\"weight\":\"semibold\",\"color\":\"#ffffff\",\"children\":[]},{\"type\":\"Spacer\",\"children\":[]},{\"type\":\"Text\",\"value\":{{ (grandTotalFormatted) | tojson }},\"weight\":\"bold\",\"size\":\"md\",\"color\":\"#ffffff\",\"children\":[]}]}{%- endset -%}{{- (_c[1:] if _c and _c[0] == ',' else _c) -}}]}]}]}",
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "widget",
    "type": "object",
    "properties": {
      "brand": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "logo": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "logo"
        ],
        "additionalProperties": false
      },
      "quoteId": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "sku": {
              "type": "string"
            },
            "manufacturer": {
              "type": "string"
            },
            "unitPriceFormatted": {
              "type": "string",
              "pattern": "^\\$\\d+(?:\\.\\d{2})?$"
            },
            "quantity": {
              "type": "number"
            },
            "subtotalFormatted": {
              "type": "string",
              "pattern": "^\\$\\d+(?:\\.\\d{2})?$"
            }
          },
          "required": [
            "id",
            "description",
            "sku",
            "manufacturer",
            "unitPriceFormatted",
            "quantity",
            "subtotalFormatted"
          ],
          "additionalProperties": false
        },
        "minItems": 2
      },
      "subtotalFormatted": {
        "type": "string"
      },
      "discount": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "formatted": {
            "type": "string",
            "pattern": "^\\$\\d+(?:\\.\\d{2})?$"
          }
        },
        "required": [
          "amount",
          "label",
          "formatted"
        ],
        "additionalProperties": false
      },
      "tax": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "rateLabel": {
            "type": "string"
          },
          "formatted": {
            "type": "string",
            "pattern": "^\\$\\d+(?:\\.\\d{2})?$"
          }
        },
        "required": [
          "amount",
          "rateLabel",
          "formatted"
        ],
        "additionalProperties": false
      },
      "grandTotalFormatted": {
        "type": "string"
      }
    },
    "required": [
      "brand",
      "quoteId",
      "items",
      "subtotalFormatted",
      "discount",
      "tax",
      "grandTotalFormatted"
    ],
    "additionalProperties": false
  },
  "outputJsonPreview": {
    "type": "Card",
    "size": "md",
    "background": "surface-elevated",
    "confirm": {
      "label": "Send quote",
      "action": {
        "type": "quote.send",
        "payload": {
          "quoteId": "Q-10482",
          "items": [
            {
              "id": "1",
              "description": "Cisco ASA 5506-X Firewall Appliance",
              "sku": "ASA5506-K9",
              "manufacturer": "Cisco",
              "unitPriceFormatted": "$620.00",
              "quantity": 1,
              "subtotalFormatted": "$620.00"
            },
            {
              "id": "2",
              "description": "Cat6 Shielded Ethernet Cable, 100ft",
              "sku": "CAT6-STP-100",
              "manufacturer": "Belden",
              "unitPriceFormatted": "$310.00",
              "quantity": 2,
              "subtotalFormatted": "$620.00"
            }
          ],
          "total": "$1,302.00"
        }
      }
    },
    "children": [
      {
        "type": "Row",
        "align": "center",
        "padding": {
          "x": 4,
          "y": 4
        },
        "gap": 3,
        "background": "#ffffff",
        "children": [
          {
            "type": "Image",
            "src": "https://www.protect-ip.ca/medias/img/logo-protectip-en.png",
            "alt": "Protect-IP",
            "width": 160,
            "height": 40,
            "fit": "contain",
            "radius": "none"
          },
          {
            "type": "Spacer"
          },
          {
            "type": "Badge",
            "label": "Quote #Q-10482",
            "color": "secondary",
            "variant": "soft",
            "size": "sm"
          }
        ]
      },
      {
        "type": "Row",
        "padding": {
          "x": 4,
          "y": 3
        },
        "background": "#111111",
        "children": [
          {
            "type": "Col",
            "children": [
              {
                "type": "Title",
                "value": "Quote items",
                "size": "md",
                "color": "#ffffff"
              },
              {
                "type": "Caption",
                "value": "2 items",
                "size": "sm",
                "color": "#e5e5e5"
              }
            ]
          },
          {
            "type": "Spacer"
          },
          {
            "type": "Badge",
            "label": "DRAFT",
            "size": "sm",
            "color": "danger",
            "variant": "solid"
          }
        ]
      },
      {
        "type": "ListView",
        "children": [
          {
            "type": "ListViewItem",
            "key": "1-0",
            "gap": 0,
            "children": [
              {
                "type": "Row",
                "gap": 3,
                "align": "stretch",
                "padding": {
                  "x": 4,
                  "y": 3
                },
                "background": "#ffffff",
                "border": {
                  "bottom": {
                    "size": 1,
                    "color": "subtle"
                  }
                },
                "children": [
                  {
                    "type": "Col",
                    "flex": 1,
                    "gap": 1,
                    "children": [
                      {
                        "type": "Text",
                        "value": "Cisco ASA 5506-X Firewall Appliance",
                        "size": "sm",
                        "weight": "semibold",
                        "maxLines": 2,
                        "color": "emphasis"
                      },
                      {
                        "type": "Caption",
                        "value": "SKU: ASA5506-K9 · Cisco",
                        "color": "secondary"
                      },
                      {
                        "type": "Caption",
                        "value": "Unit: $620.00",
                        "color": "secondary"
                      }
                    ]
                  },
                  {
                    "type": "Col",
                    "minWidth": 120,
                    "align": "end",
                    "gap": 1,
                    "children": [
                      {
                        "type": "Caption",
                        "value": "Qty: 1",
                        "color": "secondary"
                      },
                      {
                        "type": "Text",
                        "value": "$620.00",
                        "size": "sm",
                        "weight": "semibold"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "ListViewItem",
            "key": "2-1",
            "gap": 0,
            "children": [
              {
                "type": "Row",
                "gap": 3,
                "align": "stretch",
                "padding": {
                  "x": 4,
                  "y": 3
                },
                "background": "#ffffff",
                "border": {
                  "bottom": {
                    "size": 1,
                    "color": "subtle"
                  }
                },
                "children": [
                  {
                    "type": "Col",
                    "flex": 1,
                    "gap": 1,
                    "children": [
                      {
                        "type": "Text",
                        "value": "Cat6 Shielded Ethernet Cable, 100ft",
                        "size": "sm",
                        "weight": "semibold",
                        "maxLines": 2,
                        "color": "emphasis"
                      },
                      {
                        "type": "Caption",
                        "value": "SKU: CAT6-STP-100 · Belden",
                        "color": "secondary"
                      },
                      {
                        "type": "Caption",
                        "value": "Unit: $310.00",
                        "color": "secondary"
                      }
                    ]
                  },
                  {
                    "type": "Col",
                    "minWidth": 120,
                    "align": "end",
                    "gap": 1,
                    "children": [
                      {
                        "type": "Caption",
                        "value": "Qty: 2",
                        "color": "secondary"
                      },
                      {
                        "type": "Text",
                        "value": "$620.00",
                        "size": "sm",
                        "weight": "semibold"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Divider"
      },
      {
        "type": "Row",
        "padding": {
          "x": 4,
          "y": 3
        },
        "background": "#ffffff",
        "children": [
          {
            "type": "Col"
          },
          {
            "type": "Col",
            "minWidth": 260,
            "gap": 2,
            "children": [
              {
                "type": "Row",
                "children": [
                  {
                    "type": "Text",
                    "value": "Subtotal",
                    "color": "secondary"
                  },
                  {
                    "type": "Spacer"
                  },
                  {
                    "type": "Text",
                    "value": "$1,240.00"
                  }
                ]
              },
              {
                "type": "Row",
                "children": [
                  {
                    "type": "Text",
                    "value": "Tax (GST 5%)",
                    "color": "secondary"
                  },
                  {
                    "type": "Spacer"
                  },
                  {
                    "type": "Text",
                    "value": "$62.00"
                  }
                ]
              },
              {
                "type": "Row",
                "padding": {
                  "x": 4,
                  "y": 2
                },
                "background": "#111111",
                "radius": "lg",
                "children": [
                  {
                    "type": "Text",
                    "value": "Total",
                    "weight": "semibold",
                    "color": "#ffffff"
                  },
                  {
                    "type": "Spacer"
                  },
                  {
                    "type": "Text",
                    "value": "$1,302.00",
                    "weight": "bold",
                    "size": "md",
                    "color": "#ffffff"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
